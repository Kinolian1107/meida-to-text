[Unit]
Description=media2text backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target
# YouTube downloads 403 without the PO Token provider, so bring it up first.
# Wants= (not Requires=) keeps the API serving even if the provider is broken —
# only YouTube fetches degrade, and they now report POT_PROVIDER_UNAVAILABLE.
Wants=media2text-potprovider.service
After=media2text-potprovider.service

[Service]
Type=simple
User=kino
Group=kino
WorkingDirectory=/home/kino/git/media2text
ExecStart=/bin/bash -c 'set -a; source /home/kino/git/media2text/.env; set +a; export PYTHONPATH=/home/kino/git/media2text/backend; exec /home/kino/git/media2text/.venv/bin/uvicorn app.main:app --host "${API_HOST:-0.0.0.0}" --port "${API_PORT:-10002}"'
Restart=always
RestartSec=5
StartLimitBurst=30
StartLimitIntervalSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
