[Unit]
Description=media2text PO Token provider (bgutil, Docker)
Documentation=https://github.com/Brainicism/bgutil-ytdlp-pot-provider
Requires=docker.service
After=docker.service

[Service]
Type=simple
# systemd owns the container lifecycle: clear any stale one, then run in the
# foreground so restarts and shutdown are driven from here rather than from a
# Docker restart policy (two mechanisms would otherwise fight over it).
ExecStartPre=-/usr/bin/docker rm -f bgutil-provider
ExecStart=/usr/bin/docker run --rm --name bgutil-provider -p 127.0.0.1:14416:4416 --init brainicism/bgutil-ytdlp-pot-provider
ExecStop=/usr/bin/docker stop bgutil-provider
# Hold the unit "starting" until the provider actually answers, so the backend
# (which orders itself After= this unit) never races ahead and 403s.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do /usr/bin/curl -sf -m 2 http://127.0.0.1:14416/ping >/dev/null && exit 0; sleep 1; done; echo "bgutil provider did not become ready" >&2; exit 1'
TimeoutStartSec=180
Restart=always
RestartSec=5
StartLimitBurst=30
StartLimitIntervalSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
