DATA_DIR=./data
LANCEDB_URI=./data/lancedb
SQLITE_PATH=./data/sqlite/app.db

# ASR (asr-kino)
WHISPERX_PYTHON=/home/kino/asr/.venv-whisperx/bin/python3
WHISPERX_SCRIPT=/home/kino/git/asr-kino/.claude/skills/asr-local/whisperx/scripts/transcribe_whisperx.py
ASR_HOTWORDS_FILE=/home/kino/git/asr-kino/.claude/skills/asr-local/config/hotwords.txt
ASR_CORRECTIONS_FILE=/home/kino/git/asr-kino/.claude/skills/asr-local/config/corrections.json
ENABLE_DIARIZATION=false

# VL
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_SERVER_MODEL=qwen3-vl
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
QWEN_VL_GGUF=
QWEN_VL_MMPROJ=
LLAMA_SERVER_BIN=llama-server
# Auto start/stop llama-server around ASR/VL (recommended on 16GB VRAM)
LLAMA_AUTO_MANAGE=true

# Cloud LLM → bridge-cursor-cli (OpenAI-compatible)
# Start: cd ~/git/bridge-cursor-cli && follow its README
CLOUD_LLM_BASE_URL=http://127.0.0.1:18790/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=cursor-grok-4.5-medium

# Downloads
MAX_DOWNLOAD_BYTES=4294967296
YOUTUBE_COOKIES_FILE=
YTDLP_SLEEP_SECONDS=5

# Scene detect
SCENE_DETECTOR=adaptive
CONTENT_THRESHOLD=27

# API — bind 0.0.0.0 so Windows HOST can reach WSL2
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional Redis/ARQ (leave empty to use in-process asyncio.Queue)
REDIS_URL=
JOB_QUEUE_BACKEND=asyncio

# Security (leave empty to auto-generate under data/sqlite/fernet.key)
CREDENTIALS_FERNET_KEY=

# Google Drive OAuth (Phase 2 private files)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/google/callback
FRONTEND_ORIGIN=http://127.0.0.1:5173
